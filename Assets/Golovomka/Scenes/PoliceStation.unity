MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1105748773}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 15c8978ff8ceff648bd3d495e4945e3d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Golovomka.PoliceStationLayout
  entrance: {fileID: 1645655866}
  phone: {fileID: 32421935}
  exit: {fileID: 813355266}
  exitLabel: {fileID: 876274751}
  furniture: {fileID: 628267755}
  phoneSprite: {fileID: 2065391599}
  noticeBoard: {fileID: 89540721}
  leftNotice: "\u0412 \u043F\u044F\u0442\u043D\u0438\u0446\u0443 \u0443 \u0448\u043A\u043E\u043B\u044B \u044F\u0440\u043C\u0430\u0440\u043A\u0430. \u0421 \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u0434\u043E \u0448\u0435\u0441\u0442\u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043F\u0440\u043E\u0435\u0437\u0434 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u043C."
  rightNotice: "\u041D\u0430 \u043D\u043E\u0447\u043D\u0443\u044E \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0434\u0432\u0430 \u043F\u043E\u043D\u0447\u0438\u043A\u0430. \u0421 \u043A\u043E\u0440\u0438\u0446\u0435\u0439 \u043C\u043E\u0439. \u2014 \u0420\u044D\u0439"
  lowerNotice: "\u0423 \u043C\u0438\u0441\u0441\u0438\u0441 \u0423\u043E\u043B\u0448 \u043D\u0430\u0448\u043B\u0430\u0441\u044C \u0441\u043E\u0431\u0430\u043A\u0430. \u0421\u043F\u0430\u043B\u0430 \u0443 \u043D\u0435\u0451 \u0432 \u0433\u0430\u0440\u0430\u0436\u0435. \u0415\u0441\u043B\u0438 \u043F\u043E\u0437\u0432\u043E\u043D\u0438\u0442 \u0435\u0449\u0451 \u0440\u0430\u0437, \u0441\u043A\u0430\u0436\u0438\u0442\u0435, \u0447\u0442\u043E \u043C\u044B \u0440\u0430\u0434\u044B."
