    message: "\u0425\u043B\u0435\u0431\n\u041C\u043E\u043B\u043E\u043A\u043E\n\u042F\u0439\u0446\u0430\n\u041A\u0430\u0440\u0442\u043E\u0448\u043A\u0430\n\u042F\u0431\u043B\u043E\u043A\u0438\n\n\u041B\u0451\u0448, \u0445\u043B\u0435\u0431 \u0432\u043E\u0437\u044C\u043C\u0438 \u0432 \u043F\u0435\u043A\u0430\u0440\u043D\u0435 \u0443 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438. \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0442\u043E\u0442 \u0441\u043B\u0430\u0434\u043A\u0438\u0439, \u0447\u0442\u043E \u0432 \u043F\u0440\u043E\u0448\u043B\u044B\u0439 \u0440\u0430\u0437. \u2014 \u041F\u0430\u043F\u0430"
