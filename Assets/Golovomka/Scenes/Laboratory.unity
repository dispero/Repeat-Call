    message: "\u041B\u0451\u0448, \u044F \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u0436\u0434\u0430\u043B. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0439 \u0438 \u0434\u043E\u0436\u0434\u0438\u0441\u044C \u043C\u0435\u043D\u044F \u0443 \u043F\u0440\u043E\u0445\u043E\u0434\u043D\u043E\u0439. \u041F\u043E\u0439\u0434\u0451\u043C \u0434\u043E\u043C\u043E\u0439 \u0432\u043C\u0435\u0441\u0442\u0435. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u043E\u0431\u0441\u0443\u0434\u0438\u043C \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435. \u2014 \u041F\u0430\u043F\u0430"
